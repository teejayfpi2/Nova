# Copy to .env and fill in. Every value is optional except the LLM ones.

# --- the brain ---
NOVA_LLM_BASE_URL=https://api.openai.com/v1
NOVA_LLM_API_KEY=sk-replace-me
NOVA_LLM_MODEL=gpt-4o-mini

# Fully local alternative (no key needed):
# NOVA_LLM_BASE_URL=http://localhost:11434/v1
# NOVA_LLM_MODEL=llama3.1

# --- server ---
NOVA_HOST=0.0.0.0
NOVA_PORT=8000
# Set this whenever the server is reachable beyond your own machine.
NOVA_AUTH_TOKEN=change-me-to-a-long-random-string

# --- voice (auto-detects the best available backend) ---
NOVA_STT_BACKEND=auto
NOVA_TTS_BACKEND=auto
NOVA_TTS_VOICE=en-US-AriaNeural
NOVA_WHISPER_MODEL=base

# --- agent behaviour ---
NOVA_MAX_STEPS=12
NOVA_SHELL=true
NOVA_DEVICE_CONTROL=true
NOVA_DATA_DIR=./data
