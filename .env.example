# Copy to .env and fill in. Every value is optional except the LLM ones.
# Nova reads .env automatically on startup (see assistant/config.py). Real
# environment variables still take precedence, so you can override any line
# for a single run without editing the file.

# --- the brain ---
NOVA_LLM_BASE_URL=https://api.openai.com/v1
NOVA_LLM_API_KEY=sk-replace-me
NOVA_LLM_MODEL=gpt-4o-mini

# Fully local alternative (no key needed):
# NOVA_LLM_BASE_URL=http://localhost:11434/v1
# NOVA_LLM_MODEL=llama3.1

# --- OpenHands (optional, but this is what makes Nova super-powered) ---
# An OpenHands agent server: point Nova at it and it gains a team of autonomous
# agents that can run terminals, edit files, browse and build software.
# NOVA_OPENHANDS_URL=http://127.0.0.1:60000
# NOVA_OPENHANDS_SESSION_KEY=your-session-api-key
# NOVA_OPENHANDS_MODEL=openhands_Default
# NOVA_OPENHANDS_WORKDIR=/workspace
# NOVA_OPENHANDS_TIMEOUT=60
#
# To use the OpenHands LLM proxy as Nova's brain instead of OpenAI, set:
# NOVA_LLM_BASE_URL=https://llm-proxy.app.all-hands.dev/v1
# NOVA_LLM_MODEL=deepseek-v4.1-flash
# NOVA_LLM_HEADERS={"X-Session-API-Key": "${SESSION_API_KEY}"}
# and leave NOVA_LLM_API_KEY empty; Nova refreshes a short-lived key itself
# from OH_LLM_API_KEY_REFRESH_URL when that variable is present.

# --- server ---
NOVA_HOST=0.0.0.0
NOVA_PORT=8000
# Set this whenever the server is reachable beyond your own machine.
NOVA_AUTH_TOKEN=change-me-to-a-long-random-string

# --- voice (auto-detects the best available backend) ---
NOVA_STT_BACKEND=auto
NOVA_TTS_BACKEND=auto
NOVA_TTS_VOICE=en-US-AriaNeural
NOVA_WHISPER_MODEL=base

# --- agent behaviour ---
NOVA_MAX_STEPS=12
NOVA_SHELL=true
NOVA_DEVICE_CONTROL=true
NOVA_DATA_DIR=./data
